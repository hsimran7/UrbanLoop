# UrbanLoop — Root Project Overview
# Individual env files are in:
#   backend/.env  (backend credentials)
#   frontend/.env (frontend API URL)
#
# See backend/.env.example and frontend/.env.example for templates.

# Quick reference — Backend (.env):
#   MONGODB_URI=             ← Your MongoDB Atlas connection string
#   JWT_ACCESS_SECRET=       ← Strong random secret
#   JWT_REFRESH_SECRET=      ← Strong random secret
#   PORT=3000
#   NODE_ENV=development
#   FRONTEND_URL=http://localhost:5173
#   CLOUDINARY_CLOUD_NAME=   ← Your Cloudinary cloud name
#   CLOUDINARY_API_KEY=      ← Your Cloudinary API key
#   CLOUDINARY_API_SECRET=   ← Your Cloudinary API secret

# Quick reference — Frontend (.env):
#   VITE_API_URL=http://localhost:3000/api/v1
#   VITE_SOCKET_URL=http://localhost:3000
