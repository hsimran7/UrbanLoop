# Server Config
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://urbanloop_user:urbanloop_secure_password@localhost:5432/urbanloop_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Security and JWT Tokens
JWT_ACCESS_SECRET=urbanloop_access_token_secure_secret_key_2026_jwt
JWT_REFRESH_SECRET=urbanloop_refresh_token_secure_secret_key_2026_jwt

# Token expirations in seconds (Access: 15m = 900, Refresh: 7d = 604800)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000
