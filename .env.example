# UrbanLoop Environment Variables Template
# Copy this file to .env and fill in your actual configuration values.

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/urbanloop?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_SECRET=your_jwt_access_token_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Cloudinary Storage Configuration (Optional - for image upload verification)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI / Gemini API Credentials (Optional - for citizen report analysis)
AI_API_KEY=your_gemini_api_key_here
