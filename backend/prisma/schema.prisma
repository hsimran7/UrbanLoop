generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String
  role                     UserRole                  @default(CITIZEN)
  status                   UserStatus                @default(PENDING)
  emailVerified            Boolean                   @default(false)
  verificationTokenHash    String?                   @unique
  verificationTokenExpires DateTime?
  passwordResetTokenHash   String?                   @unique
  passwordResetExpires     DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  name                     String?
  phone                    String?
  auditLogs                AuditLog[]
  supervisedTeams          CollectionTeam[]          @relation("TeamSupervisor")
  departmentMemberships    DepartmentMembership[]
  driverProfile            DriverProfile?
  facilityStaffAssignments FacilityStaffAssignment[]
  properties               Property[]
  refreshTokens            RefreshToken[]
  assignedRequests         ServiceRequest[]          @relation("RequestAssignee")
  submittedRequests        ServiceRequest[]          @relation("RequestCreator")
  workerProfile            WorkerProfile?
  notifications            Notification[]
}

model RefreshToken {
  id            String        @id @default(uuid())
  tokenHash     String        @unique
  userId        String
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  revoked       Boolean       @default(false)
  replacedById  String?       @unique
  replacedBy    RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedToken RefreshToken? @relation("TokenRotation")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  type           String    // ASSIGNMENT_NEW, EMERGENCY_TASK, AREA_COMPLETED, SYSTEM
  title          String
  body           String
  data           Json?     // arbitrary payload (assignmentId, areaName, etc.)
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]
}

model District {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([stateId, name])
}

model City {
  id         String   @id @default(uuid())
  name       String   @unique
  districtId String
  timezone   String   @default("Asia/Kolkata")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  wards      Ward[]
}

model Ward {
  id        String   @id @default(uuid())
  number    Int
  name      String
  cityId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  areas           Area[]
  city            City                       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  weeklySchedules WeeklyCollectionSchedule[]

  @@unique([cityId, number])
}

model Area {
  id               String               @id @default(uuid())
  name             String
  wardId           String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ward             Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)
  collectionPoints CollectionPoint[]
  schedules        CollectionSchedule[]
  dailyAssignments DailyAssignment[]
  properties       Property[]
  routes           Route[]
  exceptions       ScheduleException[]
  serviceRequests  ServiceRequest[]
  serviceZones     ServiceZone[]

  @@unique([wardId, name])
}

model Property {
  id               String            @id @default(uuid())
  address          String
  latitude         Float
  longitude        Float
  ownerId          String
  areaId           String
  streetId         String?
  status           PropertyStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  collectionPoints CollectionPoint[]
  area             Area              @relation(fields: [areaId], references: [id])
  street           Street?           @relation(fields: [streetId], references: [id])
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routeStops       RouteStop[]
  serviceRequests  ServiceRequest[]
  schedules        CollectionSchedule[]
}

model CollectionPoint {
  id                     String                  @id @default(uuid())
  name                   String
  latitude               Float
  longitude              Float
  propertyId             String?
  areaId                 String
  status                 CollectionPointStatus   @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  serviceZoneId          String?
  streetId               String?
  bins                   Bin[]
  collectionEvents       CollectionEvent[]
  area                   Area                    @relation(fields: [areaId], references: [id])
  property               Property?               @relation(fields: [propertyId], references: [id])
  serviceZone            ServiceZone?            @relation(fields: [serviceZoneId], references: [id])
  street                 Street?                 @relation(fields: [streetId], references: [id])
  dailyAssignmentTargets DailyAssignmentTarget[]
  routeStops             RouteStop[]
  serviceRequests        ServiceRequest[]
}

model Bin {
  id                     String                  @id @default(uuid())
  qrCodeId               String                  @unique
  type                   BinType
  status                 BinStatus               @default(EMPTY)
  verificationStatus     PropertyStatus          @default(VERIFIED)
  condition              BinCondition            @default(GOOD)
  collectionPointId      String
  currentFillLevel       Int                     @default(0)
  lastTelemetryAt        DateTime?
  telemetryStatus        TelemetryStatus         @default(NEVER_CONNECTED)
  lastEmptiedAt          DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  collectionPoint        CollectionPoint         @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  alerts                 BinAlert[]
  telemetries            BinTelemetry[]
  collectionEvents       CollectionEvent[]
  dailyAssignmentTargets DailyAssignmentTarget[]
  device                 IoTDevice?
  serviceRequests        ServiceRequest[]
  schedules              CollectionSchedule[]

  @@index([lastTelemetryAt])
  @@index([currentFillLevel])
  @@index([telemetryStatus])
}

model IoTDevice {
  id               String          @id @default(uuid())
  deviceIdentifier String          @unique
  binId            String          @unique
  status           IoTDeviceStatus @default(ACTIVE)
  credentialHash   String
  lastSeenAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  telemetries      BinTelemetry[]
  bin              Bin             @relation(fields: [binId], references: [id], onDelete: Cascade)
}

model BinTelemetry {
  id             String          @id @default(uuid())
  binId          String
  fillLevel      Int
  batteryLevel   Int?
  temperature    Float?
  signalStrength Int?
  recordedAt     DateTime
  receivedAt     DateTime        @default(now())
  source         TelemetrySource
  deviceId       String?
  eventId        String?
  createdAt      DateTime        @default(now())
  bin            Bin             @relation(fields: [binId], references: [id], onDelete: Cascade)
  device         IoTDevice?      @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, eventId])
  @@index([binId, recordedAt])
}

model BinAlert {
  id          String        @id @default(uuid())
  binId       String
  type        BinAlertType
  severity    AlertSeverity
  status      AlertStatus
  triggeredAt DateTime      @default(now())
  resolvedAt  DateTime?
  latestValue Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bin         Bin           @relation(fields: [binId], references: [id], onDelete: Cascade)
}

model CollectionSchedule {
  id               String              @id @default(uuid())
  areaId           String
  wasteType        BinType
  dayOfWeek        DayOfWeek
  startTime        String
  endTime          String
  status           ScheduleStatus      @default(ACTIVE)
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  propertyId       String?
  binId            String?
  area             Area                @relation(fields: [areaId], references: [id], onDelete: Cascade)
  dailyAssignments DailyAssignment[]
  exceptions       ScheduleException[]
  property         Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bin              Bin?                @relation(fields: [binId], references: [id], onDelete: Cascade)
}

model ScheduleException {
  id                   String              @id @default(uuid())
  areaId               String
  scheduleId           String?
  originalDate         DateTime
  replacementDate      DateTime?
  replacementStartTime String?
  replacementEndTime   String?
  reason               String
  type                 ExceptionType
  wasteType            BinType?
  createdBy            String
  createdAt            DateTime            @default(now())
  dailyAssignments     DailyAssignment[]
  area                 Area                @relation(fields: [areaId], references: [id], onDelete: Cascade)
  schedule             CollectionSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model WorkerProfile {
  id               String                  @id @default(uuid())
  userId           String                  @unique
  employeeCode     String                  @unique
  employmentStatus WorkerEmploymentStatus  @default(ACTIVE)
  phone            String?
  joinedAt         DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  memberships         TeamMembership[]
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftAssignments    WorkerShiftAssignment[]
  primaryAssignments  DailyAssignment[]       @relation("PrimaryWorker")
  partnerAssignments  DailyAssignment[]       @relation("PartnerWorker")
  driverAssignments   DailyAssignment[]       @relation("DriverWorker")
}

model CollectionTeam {
  id               String                  @id @default(uuid())
  name             String
  code             String                  @unique
  status           TeamStatus              @default(ACTIVE)
  supervisorId     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  supervisor       User?                   @relation("TeamSupervisor", fields: [supervisorId], references: [id])
  assignments      DailyAssignment[]
  routeAssignments DailyRouteAssignment[]
  serviceRequests  ServiceRequest[]
  memberships      TeamMembership[]
  responsibilities TeamServiceAssignment[]
  wasteLoads       WasteLoad[]
}

model TeamMembership {
  id             String         @id @default(uuid())
  teamId         String
  workerId       String
  role           TeamMemberRole
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdAt      DateTime       @default(now())
  team           CollectionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Shift {
  id               String                  @id @default(uuid())
  name             String
  startTime        String
  endTime          String
  cutoffMinutes    Int                     @default(60)
  status           ShiftStatus             @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  dailyAssignments DailyAssignment[]
  assignments      WorkerShiftAssignment[]
  weeklySchedules  WeeklyCollectionSchedule[]
}

model WorkerShiftAssignment {
  id        String            @id @default(uuid())
  workerId  String
  shiftId   String
  workDate  DateTime
  status    WorkerShiftStatus @default(ASSIGNED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  shift     Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  worker    WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, shiftId, workDate])
}

model ServiceZone {
  id               String                  @id @default(uuid())
  areaId           String
  name             String
  code             String                  @unique
  status           ServiceZoneStatus       @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  collectionPoints CollectionPoint[]
  assignments      DailyAssignment[]
  streets          Street[]
  area             Area                       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  responsibilities TeamServiceAssignment[]
  weeklySchedules  WeeklyCollectionSchedule[]
}

model Street {
  id               String               @id @default(uuid())
  name             String
  serviceZoneId    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  serviceZone      ServiceZone          @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)
  collectionPoints CollectionPoint[]
  properties       Property[]

  @@unique([serviceZoneId, name])
}

model TeamServiceAssignment {
  id             String                      @id @default(uuid())
  teamId         String
  serviceZoneId  String
  wasteType      BinType?
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  status         TeamServiceAssignmentStatus @default(ACTIVE)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  serviceZone    ServiceZone                 @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)
  team           CollectionTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model DailyAssignment {
  id                  String                  @id @default(uuid())
  assignmentDate      DateTime
  teamId              String?
  primaryWorkerId     String?
  partnerWorkerId     String?
  driverId            String?
  vehicleId           String?
  serviceZoneId       String
  areaId              String
  scheduleId          String?
  scheduleExceptionId String?
  wasteType           BinType
  shiftId             String
  status              AssignmentStatus        @default(CREATED)
  generationSource    GenerationSource        @default(AUTOMATIC)
  generatedAt         DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  startedAt           DateTime?
  startedById         String?
  completedAt         DateTime?
  completedById       String?
  
  // Manual Planner Fields
  priority            AssignmentPriority      @default(NORMAL)
  notes               String?
  estimatedDuration   Int?
  estimatedBinCount   Int?

  collectionEvents    CollectionEvent[]
  area                Area                    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  scheduleException   ScheduleException?      @relation(fields: [scheduleExceptionId], references: [id])
  schedule            CollectionSchedule?     @relation(fields: [scheduleId], references: [id])
  serviceZone         ServiceZone             @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)
  shift               Shift                   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  team                CollectionTeam?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  primaryWorker       WorkerProfile?          @relation("PrimaryWorker", fields: [primaryWorkerId], references: [id])
  partnerWorker       WorkerProfile?          @relation("PartnerWorker", fields: [partnerWorkerId], references: [id])
  driver              WorkerProfile?          @relation("DriverWorker", fields: [driverId], references: [id])
  vehicle             Vehicle?                @relation(fields: [vehicleId], references: [id])
  targets             DailyAssignmentTarget[]
  wasteLoads          WasteLoad[]

  @@unique([assignmentDate, teamId, serviceZoneId, shiftId, wasteType])
}

model DailyAssignmentTarget {
  id                String            @id @default(uuid())
  assignmentId      String
  collectionPointId String
  binId             String
  status            TargetStatus      @default(PENDING)
  addedReason       AddedReason       @default(SCHEDULED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  collectedAt       DateTime?
  collectedById     String?
  collectionEvents  CollectionEvent[]
  assignment        DailyAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  bin               Bin               @relation(fields: [binId], references: [id], onDelete: Cascade)
  collectionPoint   CollectionPoint   @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, collectionPointId, binId])
}

model CollectionEvent {
  id                 String                 @id @default(uuid())
  assignmentId       String
  targetId           String
  binId              String
  collectionPointId  String
  workerId           String
  teamId             String
  eventType          CollectionEventType
  occurredAt         DateTime
  receivedAt         DateTime               @default(now())
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  notes              String?
  reasonCode         String?
  evidenceId         String?
  clientEventId      String                 @unique
  createdAt          DateTime               @default(now())
  distanceFromTarget Float?
  verificationLevel  CollectionVerification @default(UNVERIFIED)
  assignment         DailyAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  bin                Bin                    @relation(fields: [binId], references: [id], onDelete: Cascade)
  collectionPoint    CollectionPoint        @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  target             DailyAssignmentTarget  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  serviceRequests    ServiceRequest[]
  corrections        SupervisorCorrection[] @relation("OriginalEvent")
  wasteLoadItems     WasteLoadItem?
}

model CollectionEvidence {
  id         String   @id @default(uuid())
  storageKey String
  mimeType   String
  size       Int
  uploadedBy String
  createdAt  DateTime @default(now())
  metadata   Json?
}

model SupervisorCorrection {
  id               String          @id @default(uuid())
  originalEventId  String
  correctedById    String
  correctionReason String
  correctedAt      DateTime        @default(now())
  correctedStatus  TargetStatus
  createdAt        DateTime        @default(now())
  originalEvent    CollectionEvent @relation("OriginalEvent", fields: [originalEventId], references: [id], onDelete: Cascade)
}

model WasteFacility {
  id                 String                    @id @default(uuid())
  facilityCode       String                    @unique
  name               String
  facilityType       FacilityType
  status             FacilityStatus            @default(ACTIVE)
  latitude           Float
  longitude          Float
  address            String
  dailyCapacityKg    Float?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  receipts           FacilityReceipt[]
  staffAssignments   FacilityStaffAssignment[]
  acceptedWasteTypes FacilityWasteType[]
  transfers          WasteTransfer[]
  weighingRecords    WeighingRecord[]
}

model FacilityWasteType {
  id         String        @id @default(uuid())
  facilityId String
  wasteType  BinType
  facility   WasteFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, wasteType])
}

model FacilityStaffAssignment {
  id             String        @id @default(uuid())
  userId         String
  facilityId     String
  role           String
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  facility       WasteFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
}

model WasteLoad {
  id              String              @id @default(uuid())
  loadCode        String              @unique
  assignmentId    String
  teamId          String
  wasteType       BinType
  status          WasteLoadStatus     @default(OPEN)
  createdBy       String
  openedAt        DateTime            @default(now())
  sealedAt        DateTime?
  sealedBy        String?
  sealCode        String?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  receipts        FacilityReceipt[]
  custodyEvents   WasteCustodyEvent[]
  assignment      DailyAssignment     @relation(fields: [assignmentId], references: [id])
  team            CollectionTeam      @relation(fields: [teamId], references: [id])
  items           WasteLoadItem[]
  transfers       WasteTransfer[]
  weighingRecords WeighingRecord[]
}

model WasteLoadItem {
  id                 String          @id @default(uuid())
  wasteLoadId        String
  collectionEventId  String          @unique
  assignmentTargetId String
  binId              String
  collectionPointId  String
  addedAt            DateTime        @default(now())
  collectionEvent    CollectionEvent @relation(fields: [collectionEventId], references: [id], onDelete: Cascade)
  wasteLoad          WasteLoad       @relation(fields: [wasteLoadId], references: [id], onDelete: Cascade)
}

model WasteTransfer {
  id                    String         @id @default(uuid())
  wasteLoadId           String
  destinationFacilityId String
  status                TransferStatus @default(PLANNED)
  dispatchedAt          DateTime?
  dispatchedById        String?
  arrivedAt             DateTime?
  arrivedById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  facility              WasteFacility  @relation(fields: [destinationFacilityId], references: [id])
  wasteLoad             WasteLoad      @relation(fields: [wasteLoadId], references: [id], onDelete: Cascade)
}

model WeighingRecord {
  id             String            @id @default(uuid())
  wasteLoadId    String
  facilityId     String
  grossWeightKg  Float
  tareWeightKg   Float
  netWeightKg    Float
  weighingMethod WeighingMethod
  weighedAt      DateTime          @default(now())
  recordedBy     String
  evidenceId     String?
  createdAt      DateTime          @default(now())
  receipts       FacilityReceipt[]
  facility       WasteFacility     @relation(fields: [facilityId], references: [id])
  wasteLoad      WasteLoad         @relation(fields: [wasteLoadId], references: [id], onDelete: Cascade)
}

model FacilityReceipt {
  id                String                  @id @default(uuid())
  receiptCode       String                  @unique
  wasteLoadId       String
  facilityId        String
  weighingRecordId  String
  status            ReceiptStatus
  acceptedWeightKg  Float
  rejectedWeightKg  Float
  rejectionReason   String?
  receivedBy        String
  receivedAt        DateTime                @default(now())
  notes             String?
  createdAt         DateTime                @default(now())
  facility          WasteFacility           @relation(fields: [facilityId], references: [id])
  wasteLoad         WasteLoad               @relation(fields: [wasteLoadId], references: [id])
  weighingRecord    WeighingRecord          @relation(fields: [weighingRecordId], references: [id], onDelete: Cascade)
  processingRecords WasteProcessingRecord[]
}

model WasteProcessingRecord {
  id                String            @id @default(uuid())
  facilityReceiptId String
  processType       ProcessType
  inputWeightKg     Float
  outputWeightKg    Float?
  residueWeightKg   Float?
  massBalanceStatus MassBalanceStatus
  processedAt       DateTime          @default(now())
  recordedBy        String
  notes             String?
  createdAt         DateTime          @default(now())
  receipt           FacilityReceipt   @relation(fields: [facilityReceiptId], references: [id], onDelete: Cascade)
}

model WasteCustodyEvent {
  id          String           @id @default(uuid())
  wasteLoadId String
  eventType   CustodyEventType
  actorId     String
  facilityId  String?
  occurredAt  DateTime         @default(now())
  metadata    Json?
  createdAt   DateTime         @default(now())
  wasteLoad   WasteLoad        @relation(fields: [wasteLoadId], references: [id], onDelete: Cascade)
}

model Department {
  id                 String                 @id @default(uuid())
  code               String                 @unique
  name               String
  status             String                 @default("ACTIVE")
  parentDepartmentId String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  memberships        DepartmentMembership[]
  serviceRequests    ServiceRequest[]
}

model DepartmentMembership {
  id             String     @id @default(uuid())
  departmentId   String
  userId         String
  membershipRole String
  status         String     @default("ACTIVE")
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdAt      DateTime   @default(now())
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model ServiceRequestCategory {
  id                  String                 @id @default(uuid())
  code                String                 @unique
  name                String
  description         String
  status              String                 @default("ACTIVE")
  defaultPriority     ServiceRequestPriority @default(NORMAL)
  defaultDepartmentId String?
  slaPolicyId         String?
  requiresLocation    Boolean                @default(false)
  allowsAnonymous     Boolean                @default(false)
  requiresEvidence    Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  serviceRequests     ServiceRequest[]
}

model ServiceRequest {
  id                   String                            @id @default(uuid())
  requestCode          String                            @unique
  createdByUserId      String?
  categoryId           String
  areaId               String
  propertyId           String?
  collectionPointId    String?
  binId                String?
  collectionEventId    String?
  title                String
  description          String
  priority             ServiceRequestPriority            @default(NORMAL)
  status               ServiceRequestStatus              @default(SUBMITTED)
  source               ServiceRequestSource              @default(CITIZEN_PORTAL)
  latitude             Float?
  longitude            Float?
  addressText          String?
  assignedDepartmentId String?
  assignedTeamId       String?
  assignedUserId       String?
  submittedAt          DateTime                          @default(now())
  acknowledgedAt       DateTime?
  workStartedAt        DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  area                 Area                              @relation(fields: [areaId], references: [id])
  department           Department?                       @relation(fields: [assignedDepartmentId], references: [id])
  team                 CollectionTeam?                   @relation(fields: [assignedTeamId], references: [id])
  assignee             User?                             @relation("RequestAssignee", fields: [assignedUserId], references: [id])
  bin                  Bin?                              @relation(fields: [binId], references: [id])
  category             ServiceRequestCategory            @relation(fields: [categoryId], references: [id])
