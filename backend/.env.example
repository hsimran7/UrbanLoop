# ============================================================
# UrbanLoop Backend — Environment Configuration
# ============================================================
# IMPORTANT: Fill in YOUR OWN values below.
# Do NOT share this file. Do NOT commit this to Git.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- MongoDB (YOUR OWN Atlas or local database) ---
# Example Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanloop_new?retryWrites=true&w=majority
# Example local: mongodb://localhost:27017/urbanloop_new
MONGODB_URI=

# --- JWT Secrets (generate strong random strings — e.g. openssl rand -hex 64) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Frontend URL (CORS) ---
# Set to your Vite dev server URL (or production URL)
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (YOUR OWN account) ---
# Sign up at https://cloudinary.com — credentials found in Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
